prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include
mxincludedir=${includedir}/mx

Name: @PROJECT_NAME@
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Cflags: -I${includedir} -I${mxincludedir} @MXLIB_PC_CFLAGS@
Libs: -L${libdir} -lmxlib @MXLIB_PC_LDFLAGS@
